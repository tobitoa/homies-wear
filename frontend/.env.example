# Copy to `.env` for local dev: `cp .env.example .env`
# On Render (Static Site → Environment), set these same keys instead
# (Vite bakes them in at build time, so redeploy after changing them).

# Hosted backend (include the /api suffix)
VITE_API_URL=https://homies-wear.onrender.com/api
# Hosted backend socket host (no /api suffix)
VITE_SOCKET_URL=https://homies-wear.onrender.com
