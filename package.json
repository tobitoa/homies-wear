{
  "name": "homies-wear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "preview:frontend": "npm --prefix frontend run preview",
    "server": "node server/server.js",
    "seed": "node server/seeds/seed.js",
    "test": "node server/tests/test-runner.js",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css}\" \"frontend/*.js\" \"frontend/*.html\" \"server/**/*.js\"",
    "format:frontend": "npm --prefix frontend run format"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "mongoose": "latest",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "prettier": "latest"
  }
}
